---
import { languages, locales } from '../i18n/ui';
import { localizePath, getLangFromUrl, useTranslations } from '../i18n/utils';

/*
  Переключатель языка — флагами (SVG, а не эмодзи: эмодзи-флаги на Windows
  показываются буквами). Название языка остаётся в aria-label/title для
  доступности и подсказки при наведении. RU / CN / UK (для English).
*/
const current = getLangFromUrl(Astro.url);
const t = useTranslations(current);
const path = Astro.url.pathname;
---

<nav class="langswitch" aria-label={t('a11y.langSwitch')}>
  {
    locales.map((l) => (
      <a
        href={localizePath(path, l)}
        hreflang={l}
        title={languages[l]}
        aria-label={languages[l]}
        aria-current={l === current ? 'true' : undefined}
      >
        {l === 'ru' && (
          <svg viewBox="0 0 22 15" aria-hidden="true">
            <rect width="22" height="15" fill="#fff" />
            <rect y="5" width="22" height="5" fill="#0039A6" />
            <rect y="10" width="22" height="5" fill="#D52B1E" />
          </svg>
        )}
        {l === 'zh' && (
          <svg viewBox="0 0 22 15" aria-hidden="true">
            <defs>
              <path id="cnstar" d="M0,-1 L0.2245,-0.309 L0.951,-0.309 L0.363,0.118 L0.588,0.809 L0,0.382 L-0.588,0.809 L-0.363,0.118 L-0.951,-0.309 L-0.2245,-0.309 Z" />
            </defs>
            <rect width="22" height="15" fill="#DE2910" />
            <g fill="#FFDE00">
              <use href="#cnstar" transform="translate(4 4) scale(2.7)" />
              <use href="#cnstar" transform="translate(7.8 1.5) scale(0.9)" />
              <use href="#cnstar" transform="translate(9.3 3.1) scale(0.9)" />
              <use href="#cnstar" transform="translate(9.3 5.3) scale(0.9)" />
              <use href="#cnstar" transform="translate(7.8 6.9) scale(0.9)" />
            </g>
          </svg>
        )}
        {l === 'en' && (
          <svg viewBox="0 0 22 15" aria-hidden="true">
            <rect width="22" height="15" fill="#012169" />
            <g stroke="#fff" stroke-width="3">
              <path d="M0,0 L22,15" />
              <path d="M22,0 L0,15" />
            </g>
            <g stroke="#C8102E" stroke-width="1.6">
              <path d="M0,0 L22,15" />
              <path d="M22,0 L0,15" />
            </g>
            <path d="M11,0 V15 M0,7.5 H22" stroke="#fff" stroke-width="5" />
            <path d="M11,0 V15 M0,7.5 H22" stroke="#C8102E" stroke-width="3" />
          </svg>
        )}
      </a>
    ))
  }
</nav>

<style>
  .langswitch {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .langswitch a {
    display: block;
    width: 26px;
    height: 18px;
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid rgba(245, 242, 236, 0.25);
    opacity: 0.5;
    outline: 2px solid transparent;
    outline-offset: 2px;
    transition:
      opacity 0.15s ease,
      outline-color 0.15s ease,
      border-color 0.15s ease;
  }
  .langswitch a svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .langswitch a:hover {
    opacity: 1;
  }
  .langswitch a[aria-current='true'] {
    opacity: 1;
    border-color: var(--brass);
    outline-color: var(--brass);
  }
</style>
