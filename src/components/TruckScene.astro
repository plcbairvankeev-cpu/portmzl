---
/**
 * TruckScene — оригинальная векторная иллюстрация героя главной:
 * фура едет по трассе к пограничному переходу и сухому порту.
 * Не фотография и не сток (запрет 1 §6.2): рисунок в фирменных цветах.
 * Декоративная — aria-hidden; смысл дублируют заголовок и коридор.
 * Готова принять видео: при наличии файла ставится <video> поверх (см. HomeBody).
 */
---

<svg
  class="scene"
  viewBox="0 0 1200 440"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="ts-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0a1421" />
      <stop offset="1" stop-color="#13253d" />
    </linearGradient>
    <linearGradient id="ts-road" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0d1a29" />
      <stop offset="1" stop-color="#060f19" />
    </linearGradient>
  </defs>

  <rect width="1200" height="440" fill="url(#ts-sky)" />

  <!-- звёзды -->
  <g fill="#C8A45C" opacity=".5">
    <circle cx="120" cy="70" r="1.6" /><circle cx="300" cy="44" r="1.2" />
    <circle cx="520" cy="82" r="1.4" /><circle cx="705" cy="50" r="1.1" />
    <circle cx="1050" cy="62" r="1.6" /><circle cx="860" cy="98" r="1.2" />
    <circle cx="180" cy="120" r="1.1" />
  </g>

  <!-- луна -->
  <circle cx="930" cy="118" r="52" fill="#C8A45C" opacity=".13" />
  <circle cx="930" cy="118" r="52" fill="none" stroke="#C8A45C" stroke-width="1.5" opacity=".38" />

  <!-- маршрутная дуга Москва → площадка -->
  <path d="M -20 150 Q 480 66 1000 188" fill="none" stroke="#C8A45C" stroke-width="2" stroke-dasharray="7 6" opacity=".5" />

  <!-- дальний силуэт: контейнеры + пограничный переход -->
  <g stroke="#C8A45C" stroke-width="1" opacity=".92">
    <rect x="792" y="252" width="46" height="20" fill="#2b3a52" />
    <rect x="792" y="232" width="46" height="20" fill="#33455f" />
    <rect x="840" y="252" width="46" height="20" fill="#33455f" />
    <rect x="1100" y="252" width="46" height="20" fill="#2b3a52" />
    <rect x="1100" y="232" width="46" height="20" fill="#33455f" />
  </g>
  <g fill="#33455f" stroke="#C8A45C" stroke-width="1.5">
    <rect x="905" y="176" width="30" height="120" />
    <rect x="1055" y="176" width="30" height="120" />
    <path d="M905 176 h180 v32 h-180 z" />
    <rect x="962" y="152" width="66" height="26" fill="#2b3a52" />
  </g>
  <path d="M935 208 q60 -30 120 0" fill="none" stroke="#C8A45C" stroke-width="2" opacity=".8" />

  <!-- горизонт -->
  <line x1="0" y1="296" x2="1200" y2="296" stroke="#C8A45C" stroke-width="1" opacity=".22" />

  <!-- дорога (перспектива к переходу) -->
  <polygon points="-20,412 -20,322 1000,280 1000,300" fill="url(#ts-road)" />
  <line class="ts-dash" x1="-20" y1="368" x2="1000" y2="290" stroke="#C8A45C" stroke-width="3" opacity=".5" stroke-dasharray="26 22" />

  <!-- красная отметка границы -->
  <circle cx="995" cy="286" r="9" fill="#B3202C" />
  <circle cx="995" cy="286" r="9" fill="none" stroke="#F5F2EC" stroke-width="2" />

  <!-- ФУРА -->
  <g transform="translate(210 4)"><g class="ts-truck">
    <ellipse cx="355" cy="358" rx="235" ry="14" fill="#000" opacity=".28" />
    <!-- прицеп -->
    <rect x="150" y="214" width="300" height="118" rx="10" fill="#F5F2EC" stroke="#C8A45C" stroke-width="3" />
    <rect x="150" y="292" width="300" height="22" fill="#B3202C" />
    <g stroke="#C8A45C" stroke-width="1" opacity=".32">
      <line x1="220" y1="216" x2="220" y2="290" /><line x1="290" y1="216" x2="290" y2="290" />
      <line x1="360" y1="216" x2="360" y2="290" />
    </g>
    <!-- кабина -->
    <path d="M456 214 h46 q12 0 18 12 l16 34 v72 h-80 z" fill="#3a4b64" stroke="#C8A45C" stroke-width="2.5" />
    <path d="M470 226 h30 q7 0 11 8 l9 20 h-59 z" fill="#8fa1b8" />
    <rect x="528" y="300" width="9" height="12" rx="2" fill="#C8A45C" />
    <!-- колёса -->
    <g>
      <circle cx="215" cy="336" r="30" fill="#0a1420" /><circle cx="215" cy="336" r="11" fill="#C8A45C" />
      <circle cx="300" cy="336" r="30" fill="#0a1420" /><circle cx="300" cy="336" r="11" fill="#C8A45C" />
      <circle cx="500" cy="336" r="30" fill="#0a1420" /><circle cx="500" cy="336" r="11" fill="#C8A45C" />
    </g>
    <!-- линии скорости -->
    <g stroke="#C8A45C" stroke-width="3" stroke-linecap="round" opacity=".5">
      <line x1="60" y1="242" x2="120" y2="242" /><line x1="38" y1="268" x2="120" y2="268" />
      <line x1="72" y1="294" x2="120" y2="294" />
    </g>
  </g></g>
</svg>

<style>
  .scene {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ts-dash {
      animation: ts-run 1.6s linear infinite;
    }
    .ts-truck {
      animation: ts-bob 3.2s ease-in-out infinite;
    }
  }
  @keyframes ts-run {
    to {
      stroke-dashoffset: -96;
    }
  }
  @keyframes ts-bob {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-2px);
    }
  }
</style>
