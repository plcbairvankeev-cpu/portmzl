---
import Section from './Section.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

/*
  Видео о группе. Файл public/video/group.mp4 — тяжёлое медиа, вне git (.gitignore),
  подключается по пути. preload="none" — не грузится, пока не нажали play.
  poster — лёгкая картинка-заставка (в git).
*/
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section title={t('video.title')}>
  <p class="lead">{t('video.lead')}</p>
  <div class="video">
    <video controls preload="none" playsinline poster="/video/group-poster.jpg">
      <source src="/video/group.mp4" type="video/mp4" />
    </video>
  </div>
</Section>

<style>
  .video {
    margin-top: 1.5rem;
    max-width: 820px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--graphite);
    line-height: 0;
  }
  .video video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 848 / 408;
    object-fit: cover;
  }
</style>
