---
/**
 * Section — секция страницы с единым вертикальным ритмом и опциональной шапкой.
 * Эйбрау (mono, --steel) — как в макетах раздела 6. Заголовок — Onest (h1/h2).
 * Ширину задаёт контейнер в Base (раздел 5.5), здесь только ритм и заголовок.
 */
interface Props {
  title?: string;
  eyebrow?: string;
  id?: string;
  as?: 'h1' | 'h2';
}

const { title, eyebrow, id, as = 'h2' }: Props = Astro.props;
const Heading = as;
---

<section class="section" id={id}>
  {
    (eyebrow || title) && (
      <header class="section__head">
        {eyebrow && <p class="section__eyebrow">{eyebrow}</p>}
        {title && <Heading class="section__title">{title}</Heading>}
      </header>
    )
  }
  <slot />
</section>

<style>
  .section {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1px solid var(--line);
  }

  .section:first-child {
    border-top: 0;
  }

  .section__head {
    margin-bottom: 1.5rem;
  }

  .section__eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-data);
    font-weight: 500;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--steel);
  }

  .section__title {
    margin: 0;
    font-size: var(--step-3);
    max-width: 20ch;
  }
</style>
