---
/**
 * CTA — блок призыва к целевому действию (заявка на расчёт). Раздел 6 ТЗ.
 * Кнопка называет действие, а не «Отправить» (тон, CLAUDE.md).
 * Оформление: --port, радиус 2px, без тени и градиента (раздел 5).
 */
interface Props {
  title: string;
  text?: string;
  label: string;
  href: string;
}

const { title, text, label, href } = Astro.props;
---

<div class="cta">
  <h2 class="cta__title">{title}</h2>
  {text && <p class="cta__text">{text}</p>}
  <a class="cta__button" href={href}>{label}</a>
</div>

<style>
  .cta {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--concrete);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .cta__title {
    margin: 0;
    font-size: var(--step-2);
  }

  .cta__text {
    margin: 0.75rem 0 0;
    color: var(--steel);
  }

  .cta__button {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--red);
    color: var(--paper);
    font-family: var(--font-body);
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--red);
    border-radius: var(--radius);
  }

  .cta__button:hover {
    background: var(--red-hover);
    border-color: var(--red-hover);
  }
  .cta__button:active {
    background: var(--red-press);
    border-color: var(--red-press);
  }
</style>
