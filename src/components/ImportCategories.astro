---
import Section from './Section.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { importCategories } from '../data/imports';

/*
  Категории товаров под ввоз в КНР — спрос китайской стороны. i18n-aware.
  ZH — из первоисточника (документ компании 23.06.2026).
*/
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const zh = lang === 'zh';
---

<Section title={t('imports.title')}>
  <p class="lead">{t('imports.lead')}</p>
  <ul class="cats" lang={zh ? 'zh-Hans' : undefined}>
    {importCategories.map((c) => <li>{c[lang]}</li>)}
  </ul>
  <p class="cats__source">{t('imports.source')}</p>
</Section>

<style>
  .cats {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cats li {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--concrete);
    font-size: var(--step--1);
  }
  .cats__source {
    margin-top: 1.5rem;
    font-family: var(--font-data);
    font-size: var(--step--1);
    color: var(--steel);
  }
</style>
