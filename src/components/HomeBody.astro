---
import Section from './Section.astro';
import Fact from './Fact.astro';
import CorridorStrip from './CorridorStrip.astro';
import CTA from './CTA.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
import { getHome } from '../i18n/content/home';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { c, translated } = getHome(lang);
const auditForm = localizePath('/audit', lang) + '#form';
---

{!translated && <p class="i18n-notice">{t('notice.untranslated')}</p>}

<section class="hero">
  <div class="hero__scene">
    <img
      class="hero__photo"
      src="/hero/hero.jpg"
      alt="Фуры TIR у автомобильного перехода Маньчжурия"
      width="1600"
      height="565"
      fetchpriority="high"
    />
  </div>
  <div class="hero__content">
    <p class="hero__eyebrow">{c.eyebrow} · <span lang="zh-Hans">满洲里陆港国际物流中心</span></p>
    <h1 class="hero__title">{c.h1Before}{' '}<Fact id="distance_to_border" inline />{' '}{c.h1After}</h1>
    <p class="hero__sub">{c.sub}</p>

    <div class="hero__actions">
      <a class="button" href={auditForm}>{c.btnPrimary}</a>
      <a class="link link--on-dark" href={localizePath('/site', lang)}>{c.btnSecondary} →</a>
    </div>
  </div>
</section>

<div class="corridor-band"><CorridorStrip /></div>

<Section>
  <div class="facts-grid">
    <Fact id="distance_to_border" />
    <Fact id="grain_capacity" />
    <Fact id="port_grade" />
    <Fact id="parking_capacity" />
  </div>
</Section>

<Section title={c.directionsHead}>
  <div class="cards">
    {
      c.directions.map((d) => (
        <a class="card" href={localizePath(d.href, lang)}>
          <h3 class="card__title">{d.title}</h3>
          <p class="card__text">{d.text}</p>
          <span class="card__more">{c.more} →</span>
        </a>
      ))
    }
  </div>
</Section>

<Section title={c.processHead}>
  <ol class="process">
    {
      c.process.map((step, i) => (
        <li class="process__step">
          <span class="process__num">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="process__title">{step.title}</h3>
            <p class="process__text">{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<Section title={c.notDoHead}>
  <ol class="notdo">
    {
      c.notDoing.map((item, i) => (
        <li class="notdo__item">
          <span class="notdo__num">{String(i + 1).padStart(2, '0')}</span>
          <span>{item}</span>
        </li>
      ))
    }
  </ol>
  <p class="notdo__close">
    {c.notDoClose} <a href={localizePath('/ved', lang)}>{c.notDoCloseLink} →</a>
  </p>
</Section>

<Section title={c.whoHead}>
  <p class="who">{c.whoBefore}{' '}<Fact id="group_branches" inline />{' '}{c.whoAfter}</p>
  <div class="facts-grid facts-grid--three">
    <Fact id="group_branches" />
    <Fact id="group_staff" />
    <Fact id="neeq_code" />
  </div>
  <p class="who__more"><a href={localizePath('/about', lang)}>{c.whoMore} →</a></p>
</Section>

<Section id="cta">
  <CTA title={c.ctaTitle} text={c.ctaText} label={c.ctaBtn} href={auditForm} />
</Section>

<style>
  /* Тёмный полноширинный герой с иллюстрацией. Выходит за контейнер на всю ширину. */
  .hero {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    min-height: clamp(360px, 50vw, 520px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--graphite);
    border-bottom: 1px solid var(--brass);
  }
  .hero__scene {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
    display: block;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(14, 27, 46, 0.94) 0%,
      rgba(14, 27, 46, 0.8) 40%,
      rgba(14, 27, 46, 0.28) 68%,
      rgba(14, 27, 46, 0) 100%
    );
  }
  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--gutter);
    color: var(--on-dark);
  }
  .hero__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-data);
    font-weight: 500;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--brass);
  }
  .hero__title {
    margin: 0;
    font-size: var(--step-4);
    max-width: 18ch;
    color: var(--on-dark);
  }
  .hero__sub {
    margin: 1.5rem 0 0;
    font-size: var(--step-1);
    color: #cbd4e0;
    max-width: 42ch;
  }
  .hero__actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  /* Полоса коридора под героем — на светлом фоне.
     Верхний отступ больше: подписи расстояний и «граница» стоят НАД линией. */
  .corridor-band {
    padding-top: 1.75rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .facts-grid--three {
    margin-top: 1.5rem;
  }

  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem 2.5rem;
    max-width: 60rem;
  }
  .process__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: baseline;
    padding-block: 0.75rem;
    border-top: 1px solid var(--line);
  }
  .process__num {
    font-family: var(--font-data);
    font-weight: 500;
    font-size: var(--step-1);
    color: var(--brass);
  }
  .process__title {
    margin: 0;
    font-size: var(--step-1);
  }
  .process__text {
    margin: 0.25rem 0 0;
    color: var(--steel);
    font-size: var(--step--1);
  }

  .notdo {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem 2rem;
    max-width: 60rem;
  }
  .notdo__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  .notdo__num {
    font-family: var(--font-data);
    font-weight: 500;
    color: var(--port);
  }
  .notdo__close {
    margin-top: 1.5rem;
    font-weight: 500;
  }

  .who {
    max-width: var(--measure);
  }

  @media (max-width: 48rem) {
    .notdo,
    .process {
      grid-template-columns: 1fr;
    }
  }
</style>
