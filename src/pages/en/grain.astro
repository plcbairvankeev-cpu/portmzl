---
// English /grain. Draft translation — needs proofreading.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Fact from '../../components/Fact.astro';
import CTA from '../../components/CTA.astro';

const nomenclature = ['rapeseed', 'flax', 'buckwheat', 'oats', 'sunflower', 'corn', 'soybean', 'rice'];
const stages = [
  'approach via the dedicated corridor',
  'intake on the covered platform',
  'customs inspection',
  'primary lab screening',
  'storage',
  'release',
];

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Grain and oilseed export via the Manzhouli crossing',
  serviceType: 'Designated imported-grain site',
  provider: { '@type': 'Organization', name: 'Порт Маньчжурия' },
  areaServed: ['RU', 'CN'],
  description:
    'A designated imported-grain site at the Manzhouli crossing: a dedicated corridor, fumigation, on-site reconditioning, ISO 9001.',
};
---

<Base
  title="Grain corridor Manzhouli — imported-grain site"
  description="A designated imported-grain site at the Manzhouli crossing: 95,600 m³, a dedicated corridor, fumigation, on-site reconditioning, ISO 9001."
  jsonLd={serviceJsonLd}
>
  <Section>
    <p class="eyebrow" lang="zh-Hans">进境粮食指定监管场地</p>
    <h1>Designated imported-grain site at the Manzhouli crossing</h1>
    <p class="lead">
      The site was built to the standards of the General Administration of Customs of China and operates within the
      China–Russia land grain corridor project.
    </p>
  </Section>

  <Section>
    <div class="facts-grid">
      <Fact id="grain_capacity" />
      <Fact id="grain_area" />
      <Fact id="grain_corridor" />
      <Fact id="grain_inspection_area" />
      <Fact id="grain_hold_area" />
      <Fact id="grain_fumigation" />
      <Fact id="grain_rework_area" />
      <Fact id="iso" />
    </div>
  </Section>

  <Section title="Commodities">
    <ul class="tags">
      {nomenclature.map((n) => <li>{n}</li>)}
    </ul>
  </Section>

  <Section title="What happens to a consignment">
    <ol class="stages">
      {stages.map((s) => <li>{s}</li>)}
    </ol>
    <p class="stages__note">
      If a consignment fails: the hold zone, on-site fumigation or reconditioning (air and optical separation).
    </p>
  </Section>

  <Section title="Why it matters">
    <p class="reason">
      The export bottleneck is not finding a buyer, but the regime and capacity on the Chinese side. On an ordinary
      terminal, a consignment that fails phytosanitary control is sent back. Here it is reconditioned on site.
    </p>
  </Section>

  <Section>
    <CTA title="Calculate a slot and lead time for your consignment" label="Request a calculation" href="/en/audit#form" />
  </Section>
</Base>

<style>
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-data);
    font-weight: 500;
  }
  .tags li {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--concrete);
    font-size: var(--step--1);
  }
  .stages {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
    counter-reset: stage;
    max-width: 44rem;
  }
  .stages li {
    counter-increment: stage;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .stages li::before {
    content: counter(stage, decimal-leading-zero);
    font-family: var(--font-data);
    font-weight: 500;
    color: var(--port);
  }
  .stages__note {
    margin-top: 1rem;
    color: var(--steel);
    max-width: var(--measure);
  }
  .reason {
    max-width: var(--measure);
  }
</style>
