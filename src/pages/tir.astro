---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Fact from '../components/Fact.astro';
import CTA from '../components/CTA.astro';
import TirCase from '../components/TirCase.astro';

const gives = [
  'одна книжка на весь маршрут',
  'без перегрузки на границе',
  'оформление на площадке в режиме одного окна',
  'работает в обе стороны',
];

const backhaul = ['лёгкая промышленность', 'электроника', 'техника и оборудование'];

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Автодоставка Москва — Маньчжурия по книжке TIR',
  serviceType: 'TIR-перевозка',
  provider: { '@type': 'Organization', name: 'Порт Маньчжурия' },
  areaServed: ['RU', 'CN'],
  description:
    'Автодоставка по книжке TIR без перегрузки на границе, оформление на площадке в режиме одного окна, в обе стороны.',
};
---

<Base
  title="TIR Москва — Маньчжурия: автодоставка без перегрузки"
  description="Автодоставка Москва — Маньчжурия по книжке TIR: одна книжка на весь маршрут, без перегрузки на границе, оформление на площадке в режиме одного окна."
  jsonLd={serviceJsonLd}
>
  <Section as="h1" title="Автодоставка Москва — Маньчжурия по книжке TIR">
    <div class="facts-grid">
      <Fact id="tir_first" />
    </div>
  </Section>

  <Section title="Что даёт TIR">
    <ul class="tags">
      {gives.map((g) => <li>{g}</li>)}
    </ul>
  </Section>

  <Section title="Обратная загрузка из КНР">
    <ul class="tags">
      {backhaul.map((b) => <li>{b}</li>)}
    </ul>
  </Section>

  <TirCase />

  <Section title="Сроки и тарифы">
    <p class="lead">Тариф и срок рассчитываем по маршруту и объёму.</p>
    <CTA
      title="Рассчитать слот и срок по вашей партии"
      label="Заказать расчёт"
      href="/audit#form"
    />
  </Section>
</Base>

<style>
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tags li {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--concrete);
    font-size: var(--step--1);
  }
  .lead {
    margin-bottom: 1.5rem;
  }
</style>
