---
import '../styles/global.css';
import { ogSlugForPath } from '../lib/pages';
import { SITE_URL, CONTACT_EMAIL, SITE_NAME } from '../lib/site';
import { cnOffice } from '../data/contacts';
import { locales, type Lang } from '../i18n/ui';
import { getLangFromUrl, useTranslations, localizePath, stripLang } from '../i18n/utils';
import LangSwitch from '../components/LangSwitch.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

/**
 * Base — каркас страницы. Мультиязычный: язык берётся из URL (/zh, /en, иначе ru).
 * «Представительство» в хроме нет: допустимо только при REPRESENTATIVE_STATUS_CONFIRMED=true (запрет 6).
 */
interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, jsonLd } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const htmlLang: Record<Lang, string> = { ru: 'ru', zh: 'zh-Hans', en: 'en' };
const ogLocale: Record<Lang, string> = { ru: 'ru_RU', zh: 'zh_CN', en: 'en_US' };

const path = Astro.url.pathname;
const base = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(path, base).href;
const ogImage = new URL(`/og/${ogSlugForPath(stripLang(path))}.png`, base).href;

// hreflang для всех языков + x-default на русский.
const alternates = locales.map((l) => ({ lang: l, href: new URL(localizePath(path, l), base).href }));

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  alternateName: '满洲里陆港国际物流中心',
  url: base.href,
  email: CONTACT_EMAIL,
  telephone: cnOffice.phones.map((p) => p.tel),
  address: {
    '@type': 'PostalAddress',
    streetAddress: cnOffice.addressZh,
    addressLocality: '满洲里 Manzhouli',
    postalCode: cnOffice.postcode,
    addressCountry: 'CN',
  },
};

const nav: { key: Parameters<typeof t>[0]; href: string }[] = [
  { key: 'nav.site', href: '/site' },
  { key: 'nav.grain', href: '/grain' },
  { key: 'nav.tir', href: '/tir' },
  { key: 'nav.ved', href: '/ved' },
  { key: 'nav.audit', href: '/audit' },
  { key: 'nav.faq', href: '/faq' },
  { key: 'nav.about', href: '/about' },
  { key: 'nav.contacts', href: '/contacts' },
];
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(stripLang(path), base).href} />

    {/* Open Graph / Twitter. OG-изображения генерируются на сборке (§8). */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    {/* Верификация Яндекс.Вебмастера (§8): вставить код после подтверждения домена. */}

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} is:inline />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}
  </head>
  <body>
    <a class="skip" href="#main">{t('a11y.skip')}</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="wordmark" href={localizePath('/', lang)}>
          <img class="wordmark__logo" src="/logo-mark.png" alt="" width="321" height="240" />
          <span class="wordmark__text">
            <span class="wordmark__ru">Порт Маньчжурия</span>
            <span class="wordmark__zh" lang="zh-Hans">满洲里陆港国际物流中心</span>
          </span>
        </a>
        <nav class="nav" aria-label={t('nav.aria')}>
          <ul class="nav__list">
            {
              nav.map((item) => {
                const href = localizePath(item.href, lang);
                return (
                  <li>
                    <a href={href} aria-current={path === href ? 'page' : undefined}>
                      {t(item.key)}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
        <LangSwitch />
      </div>
    </header>

    <Breadcrumbs />

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p class="site-footer__contact">
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
        <ul class="site-footer__legal">
          <li><a href="/presentation.pdf" download>{t('footer.presentation')}</a></li>
          <li><a href={localizePath('/passport', lang)}>{t('passport.link')}</a></li>
          <li><a href={localizePath('/legal/privacy', lang)}>{t('footer.privacy')}</a></li>
          <li><a href={localizePath('/legal/consent', lang)}>{t('footer.consent')}</a></li>
        </ul>
        <p class="site-footer__note">
          {SITE_NAME} · <span lang="zh-Hans">满洲里陆港国际物流中心</span>
        </p>
      </div>
    </footer>

    <style is:global>
      .container {
        max-width: var(--container);
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        padding: 0.5rem 0.75rem;
        background: var(--ink);
        color: var(--paper);
        z-index: 10;
      }
      .skip:focus {
        left: 0;
      }

      /* Шапка — графит, красная линия сверху, латунь снизу. */
      .site-header {
        background: var(--graphite);
        border-top: 2px solid var(--red);
        border-bottom: 1px solid var(--brass);
      }
      .site-header__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem 1.5rem;
        padding-block: 1rem;
      }

      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        color: var(--on-dark);
      }
      .wordmark__logo {
        height: 40px;
        width: auto;
        display: block;
        background: #fff;
        padding: 3px 5px;
        border-radius: var(--radius);
        flex: none;
      }
      .wordmark__text {
        display: inline-grid;
        gap: 0.1rem;
      }
      .wordmark__ru {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: var(--step-1);
        line-height: 1;
      }
      .wordmark__zh {
        font-family: var(--font-data);
        font-size: var(--step--1);
        color: var(--on-dark-muted);
      }

      .nav__list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
        font-family: var(--font-body);
        font-weight: 500;
        font-size: var(--step--1);
      }
      .nav__list a {
        color: var(--on-dark-muted);
        text-decoration: none;
        padding-bottom: 2px;
        border-bottom: 1px solid transparent;
      }
      .nav__list a:hover,
      .nav__list a[aria-current='page'] {
        color: var(--on-dark);
        border-color: var(--brass);
      }

      main.container {
        padding-block: 0;
      }

      /* Подвал — графит. */
      .site-footer {
        margin-top: clamp(3rem, 8vw, 6rem);
        border-top: 1px solid var(--brass);
        background: var(--graphite);
      }
      .site-footer__inner {
        padding-block: 2rem;
        font-size: var(--step--1);
        color: var(--on-dark-muted);
      }
      .site-footer a {
        color: var(--on-dark-muted);
        text-decoration-color: var(--brass);
      }
      .site-footer a:hover {
        color: var(--brass);
      }
      .site-footer__contact a {
        color: var(--on-dark);
      }
      .site-footer__legal {
        margin: 1rem 0 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.375rem;
      }
      .site-footer__note {
        margin: 1rem 0 0;
        font-family: var(--font-data);
        color: var(--on-dark-muted);
      }
    </style>
  </body>
</html>
