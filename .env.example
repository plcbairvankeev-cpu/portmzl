# Скопируйте этот файл в .env и заполните.
# .env в репозиторий не попадает никогда. Запрет 8 в CLAUDE.md.

# Домен и контактный e-mail. Дефолт в коде — https://portmzl.ru (основной домен).
# portmzl.com редиректит на portmzl.ru на уровне nginx (см. deploy/nginx.conf).
# SITE_URL используется для canonical, sitemap, robots.txt и абсолютных OG-URL.
SITE_URL=https://portmzl.ru
CONTACT_EMAIL=info@portmzl.ru

# Флаг статуса. Раздел 6.7 ТЗ и «лестница формулировок» из docs/traction.md.
# Пока нет письменного документа от партнёра — строго false.
# При false слово «представительство» на сайте не появляется, используется «партнёр в России».
REPRESENTATIVE_STATUS_CONFIRMED=false

# Приёмник заявок. Раздел 7.2 ТЗ. Нужны на шаге 5, не раньше.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_EMAIL_TO=

# Аналитика Яндекса. Пока пусто — код Метрики и мета-верификация НЕ подключаются.
# YANDEX_METRIKA_ID — номер счётчика (напр. 99999999); YANDEX_VERIFICATION — код из Вебмастера.
YANDEX_METRIKA_ID=
YANDEX_VERIFICATION=

# Реквизиты юрлица для /legal и /contacts. Пока пусто — на страницах видимые плейсхолдеры.
COMPANY_INN=
COMPANY_OGRN=
COMPANY_ADDRESS=
